OPENAI_API_KEY=your_openai_api_key_here
ALPHA_VANTAGE_KEY=optional_alpha_vantage_key

# Optional Langfuse tracing
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_HOST=https://cloud.langfuse.com
# (Legacy support: LANGFUSE_API_URL can also be used)

# Persistence — PostgreSQL (RDS) for production/QA, omit for local SQLite fallback
# DATABASE_URL=postgresql://username:password@your-rds-host.amazonaws.com:5432/finance_db

AWS_ACCESS_ID=your_aws_access_id_here
AWS_ACCESS_KEY=your_aws_access_key_here
